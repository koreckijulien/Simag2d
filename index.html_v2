/* ------------------------------------------------------------------ */
/* Efforts : tenseur de Maxwell sur un contour d'air                    */
/* ------------------------------------------------------------------ */
function maxwellForce(model, mesh, sol, loc, si, center, mopts) {
  mopts = mopts || {};
  const nC = mopts.nC || 9, useElem = mopts.elemB !== false;
  const shapes = model.shapes, polys = mesh.polys, P = polys[si];
  const L = sol.depth, hMin = mesh.meta.hMin;
  const solidAt = (x, y, skip) => {
    for (let s = shapes.length - 1; s >= 0; s--) {
      const q = polys[s];
      if (x < q.x0 || x > q.x1 || y < q.y0 || y > q.y1) continue;
      if (pointInPoly(x, y, q.pts)) return shapes[s].mat !== 'air' || s === skip;
    }
    return false;
  };
  const step = hMin * 0.5, dCap = 0.3 * mesh.meta.maxdim;
  function contour(d) {
    const x0 = P.x0 - d, x1 = P.x1 + d, y0 = P.y0 - d, y1 = P.y1 + d;
    return { x0, x1, y0, y1 };
  }
  function valid(d) {
    const c = contour(d);
    if (c.x0 <= mesh.box.x0 || c.x1 >= mesh.box.x1 || c.y0 <= mesh.box.y0 || c.y1 >= mesh.box.y1) return false;
    const ds = hMin;
    const test = (x, y) => solidAt(x, y, -2);
    for (let x = c.x0; x <= c.x1; x += ds) if (test(x, c.y0) || test(x, c.y1)) return false;
    for (let y = c.y0; y <= c.y1; y += ds) if (test(c.x0, y) || test(c.x1, y)) return false;
    for (let s = 0; s < shapes.length; s++) {
      if (s === si || shapes[s].mat === 'air') continue;
      const q = polys[s].pts[0];
      if (q[0] > c.x0 && q[0] < c.x1 && q[1] > c.y0 && q[1] < c.y1) return false;
    }
    return true;
  }
  let best = null, runStart = -1;
  const ds = [];
  for (let d = Math.max(1.2 * hMin, step); d < dCap; d += step) ds.push(d);
  let cur = [];
  const runs = [];
  ds.forEach(d => { if (valid(d)) cur.push(d); else { if (cur.length) runs.push(cur); cur = []; } });
  if (cur.length) runs.push(cur);
  runs.forEach(r => { if (!best || r.length > best.length) best = r; });
  if (!best || best.length < 2) return null;
  const pick = [];
  for (let k = 0; k < nC; k++) pick.push(best[Math.min(best.length - 1, Math.round((best.length - 1) * (0.15 + 0.7 * k / Math.max(1, nC - 1))))]);
  const cx = center ? center[0] * MM : (P.x0 + P.x1) / 2, cy = center ? center[1] * MM : (P.y0 + P.y1) / 2;
  const res = [];
  pick.forEach(d => {
    const c = contour(d);
    let Fx = 0, Fy = 0, T = 0;
    const nseg = (x0, y0, x1, y1, nx, ny) => {
      const len = Math.hypot(x1 - x0, y1 - y0), n = Math.max(4, Math.ceil(len / (hMin * 0.8))), dl = len / n;
      for (let k = 0; k < n; k++) {
        const x = x0 + (x1 - x0) * (k + 0.5) / n, y = y0 + (y1 - y0) * (k + 0.5) / n;
        const s = sampleAt(mesh, sol, loc, x, y);
        if (!s) continue;
        if (useElem) { s.bx = sol.bx[s.e]; s.by = sol.by[s.e]; }
        const bn = s.bx * nx + s.by * ny, b2 = s.bx * s.bx + s.by * s.by;
        const fx = (bn * s.bx - 0.5 * b2 * nx) / MU0 * dl * L, fy = (bn * s.by - 0.5 * b2 * ny) / MU0 * dl * L;
        Fx += fx; Fy += fy; T += (x - cx) * fy - (y - cy) * fx;
      }
    };
    nseg(c.x0, c.y0, c.x1, c.y0, 0, -1); nseg(c.x1, c.y0, c.x1, c.y1, 1, 0);
    nseg(c.x1, c.y1, c.x0, c.y1, 0, 1); nseg(c.x0, c.y1, c.x0, c.y0, -1, 0);
    res.push({ Fx, Fy, T, d });
  });
  const avg = k => res.reduce((s, r) => s + r[k], 0) / res.length;
  const spread = k => Math.max(...res.map(r => r[k])) - Math.min(...res.map(r => r[k]));
  return { Fx: avg('Fx'), Fy: avg('Fy'), T: avg('T'), dFx: spread('Fx'), dFy: spread('Fy'), dT: spread('T'), d: pick[Math.floor(pick.length / 2)] };
}

/* Flux embrassé par bobinage : λ = N·L·Σ ±<A>région. `ref` donne l'appartenance, le sens et le courant
   (régions « coil » de même numéro `wnd`) ; `sol` donne le champ A. Les signes des courants définissent le sens : λ d'un bobinage seul est toujours positif. */
function windingFlux(ref, mesh, sol) {
  const { px, py, tri, reg } = mesh, m = tri.length / 3, ns = ref.shapes.length;
  const area = new Float64Array(ns), intA = new Float64Array(ns);
  for (let e = 0; e < m; e++) {
    const r = reg[e]; if (r < 0) continue;
    const i = tri[3 * e], j = tri[3 * e + 1], k = tri[3 * e + 2];
    const a = Math.abs((px[j] - px[i]) * (py[k] - py[i]) - (px[k] - px[i]) * (py[j] - py[i])) / 2;
    area[r] += a; intA[r] += a * (sol.A[i] + sol.A[j] + sol.A[k]) / 3;
  }
  const map = new Map();
  ref.shapes.forEach((s, i) => {
    if (s.mat !== 'coil' || !(+s.ni) || !(area[i] > 0)) return;
    const id = Math.max(1, Math.round(+s.wnd || 1)), n = Math.max(1, +s.n || 1), ni = +s.ni;
    let w = map.get(id);
    if (!w) { w = { id, I: Math.abs(ni) / n, N: n, s0: Math.sign(ni), lambda: 0, warn: [] }; map.set(id, w); }
    else {
      if (Math.abs(Math.abs(ni) / n - w.I) > 1e-9 * Math.max(1, w.I) && w.warn.indexOf('courants différents') < 0) w.warn.push('courants différents');
      if (n !== w.N && w.warn.indexOf('nombres de spires différents') < 0) w.warn.push('nombres de spires différents');
    }
    w.lambda += Math.sign(ni) * n * (intA[i] / area[i]) * sol.depth;
  });
  return Array.from(map.values()).sort((a, b) => a.id - b.id);
}

const FEM = { windingFlux, MU0, BH_PRESETS, parseBH, makeBH, generateMesh, solve, makeLocator, sampleAt, isolines, maxwellForce,
              delaunay, pointInPoly, polyAreaSigned, shapePolyMM, materialOf, PREC_DIV };
if (typeof module !== 'undefined' && module.exports) module.exports = FEM; else root.FEM = FEM;
})(typeof self !== 'undefined' ? self : this);
