<script>(function () {
'use strict';
const $ = id => document.getElementById(id);
const F = FEM, EXS = EXAMPLES;
const cv = $('cv'), ctx = cv.getContext('2d'), stage = $('stage');

const MAT = {
  air: { label: 'Air / vide' },
  lin: { label: 'Fer linéaire' },
  steel: { label: 'Acier saturable' },
  magnet: { label: 'Aimant permanent' },
  coil: { label: 'Bobine / conducteur' }
};
const PREC_NAMES = ['', 'Grossier', 'Rapide', 'Normal', 'Fin', 'Très fin'];
const HINTS = {
  select: 'Cliquez une région pour la sélectionner, glissez pour la déplacer ou tirez ses poignées carrées. La poignée ronde au-dessus la fait tourner. Glissez dans le vide pour déplacer la vue. Molette : zoom.',
  rect: 'Rectangle : glissez d\'un coin au coin opposé.',
  circle: 'Cercle : glissez du centre vers le rayon voulu.',
  poly: 'Polygone : cliquez les sommets. Double-clic, Entrée ou clic sur le premier point pour fermer. Retour arrière : annule le dernier point. Échap : abandonne.',
  probe: 'Sonde : cliquez un point pour lire le champ. Glissez pour mesurer le flux entre deux points et tracer |B| le long du segment.'
};

/* ------------------------------ état ------------------------------ */
let model = { depth: 50, margin: 60, prec: 3, shapes: [] };
let sel = -1, tool = 'select';
let view = { cx: 0, cy: 0, s: 3 };
let grid = 2, snapOn = true;
let hist = [], histPos = -1;
let R = null;           // résultat : { mesh, sol, loc, model, isol, X, Y, ... }
let stale = false, busy = false;
let probe = null, draft = null, drag = null, spaceDown = false;
const pointers = new Map();
let pinch = null;
const opts = { field: true, flux: true, vec: false, mesh: false, bmax: 0, nflux: 24 };
let dpr = 1, raf = 0, cursorMM = null;
let C = {}, darkCanvas = true;

const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
function fnum(x) {
  if (x === 0 || !isFinite(x)) return String(x === 0 ? 0 : '—');
  const a = Math.abs(x);
  if (a >= 1e5 || a < 1e-3) return x.toExponential(3);
  return String(+x.toPrecision(4));
}
function fmm(x) { return String(+x.toFixed(3)); }

/* --------------------------- géométrie --------------------------- */
function bboxOf(s) {
  if (s.type === 'rect') return [Math.min(s.x0, s.x1), Math.min(s.y0, s.y1), Math.max(s.x0, s.x1), Math.max(s.y0, s.y1)];
  if (s.type === 'circle') return [s.cx - s.r, s.cy - s.r, s.cx + s.r, s.cy + s.r];
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
  s.pts.forEach(p => { x0 = Math.min(x0, p[0]); x1 = Math.max(x1, p[0]); y0 = Math.min(y0, p[1]); y1 = Math.max(y1, p[1]); });
  return [x0, y0, x1, y1];
}
function centroidOf(s) {
  if (s.type === 'poly') {
    let a = 0, cx = 0, cy = 0;
    for (let i = 0; i < s.pts.length; i++) {
      const p = s.pts[i], q = s.pts[(i + 1) % s.pts.length], k = p[0] * q[1] - q[0] * p[1];
      a += k; cx += (p[0] + q[0]) * k; cy += (p[1] + q[1]) * k;
    }
    if (Math.abs(a) > 1e-9) return [cx / (3 * a), cy / (3 * a)];
  }
  const b = bboxOf(s);
  return [(b[0] + b[2]) / 2, (b[1] + b[3]) / 2];
}
function areaOf(s) {
  if (s.type === 'rect') return Math.abs((s.x1 - s.x0) * (s.y1 - s.y0));
  if (s.type === 'circle') return Math.PI * s.r * s.r;
  return Math.abs(F.polyAreaSigned(s.pts));
}
function hitShape(s, x, y) {
  if (s.type === 'rect') { const b = bboxOf(s); return x >= b[0] && x <= b[2] && y >= b[1] && y <= b[3]; }
  if (s.type === 'circle') return Math.hypot(x - s.cx, y - s.cy) <= s.r;
  return F.pointInPoly(x, y, s.pts);
}
function handlesOf(s) {
  if (s.type === 'rect') {
    const b = bboxOf(s);
    return [[b[0], b[1]], [b[2], b[1]], [b[2], b[3]], [b[0], b[3]]].map((p, i) => ({ x: p[0], y: p[1], kind: 'corner', idx: i }));
  }
  if (s.type === 'circle') return [{ x: s.cx + s.r, y: s.cy, kind: 'radius', idx: 0 }];
  return s.pts.map((p, i) => ({ x: p[0], y: p[1], kind: 'vertex', idx: i }));
}
function cloneShape(s) { return JSON.parse(JSON.stringify(s)); }
function moveShape(s, o, dx, dy) {
  if (s.type === 'rect') { s.x0 = o.x0 + dx; s.x1 = o.x1 + dx; s.y0 = o.y0 + dy; s.y1 = o.y1 + dy; }
  else if (s.type === 'circle') { s.cx = o.cx + dx; s.cy = o.cy + dy; }
  else s.pts = o.pts.map(p => [p[0] + dx, p[1] + dy]);
}
const r6 = v => +v.toFixed(6);
function rotPt(p, a, c) { const co = Math.cos(a), si = Math.sin(a), dx = p[0] - c[0], dy = p[1] - c[1]; return [c[0] + dx * co - dy * si, c[1] + dx * si + dy * co]; }
/* Copie de la région tournée de `a` radians (sens trigonométrique, axe Y vers le haut) autour de c.
   Un rectangle ne reste un rectangle que pour un multiple de 90° ; sinon il devient un polygone. */
function rotatedShape(o, a, c) {
  const s = cloneShape(o), deg = a * 180 / Math.PI;
  const q = p => { const r = rotPt(p, a, c); return [r6(r[0]), r6(r[1])]; };
  if (s.type === 'circle') { const p = q([s.cx, s.cy]); s.cx = p[0]; s.cy = p[1]; }
  else if (s.type === 'poly') s.pts = s.pts.map(q);
  else {
    const b = bboxOf(s), k = deg / 90;
    const corners = [[b[0], b[1]], [b[2], b[1]], [b[2], b[3]], [b[0], b[3]]].map(q);
    if (Math.abs(k - Math.round(k)) < 1e-9) {
      const xs = corners.map(p => p[0]), ys = corners.map(p => p[1]);
      s.x0 = Math.min(...xs); s.x1 = Math.max(...xs); s.y0 = Math.min(...ys); s.y1 = Math.max(...ys);
    } else { delete s.x0; delete s.y0; delete s.x1; delete s.y1; s.type = 'poly'; s.pts = corners; }
  }
  if (s.mat === 'magnet') s.ang = r6((((+s.ang || 0) + deg) % 360 + 360) % 360);
  return s;
}
let rotUI = { ang: 90, c: 'self', x: 0, y: 0 };
function rotPivot(s) { return rotUI.c === 'origin' ? [0, 0] : rotUI.c === 'point' ? [rotUI.x, rotUI.y] : centroidOf(s); }
function applyRotation(deg) {
  const s = model.shapes[sel]; if (!s || !isFinite(deg) || deg === 0) return;
  model.shapes[sel] = rotatedShape(s, deg * Math.PI / 180, rotPivot(s));
  commit(); renderList(); buildProps(); renderResults(); invalidate();
}
function rotHandle() {
  const s = model.shapes[sel]; if (!s || tool !== 'select') return null;
  const b = bboxOf(s), c = centroidOf(s);
  return { hx: toSx(c[0]), hy: toSy(b[3]) - 30, bx: toSx(c[0]), by: toSy(b[3]) };
}
function newShape(type, geom) {
  return Object.assign({ name: 'Région ' + (model.shapes.length + 1), type, mat: 'steel', bh: 'acier', bhText: '', mur: 1000,
    ni: 1000, n: 1, wnd: 1, br: 1.2, mmur: 1.05, ang: 90, h: 0 }, geom);
}
function sanitizeModel(o) {
  if (!o || !Array.isArray(o.shapes)) return null;
  const out = { depth: +o.depth > 0 ? +o.depth : 50, margin: (o.margin != null && isFinite(+o.margin)) ? clamp(+o.margin, 0, 400) : 60, prec: clamp(Math.round(+o.prec || 3), 1, 5), shapes: [] };
  for (const s of o.shapes) {
    if (!s || !['rect', 'circle', 'poly'].includes(s.type)) return null;
    const t = newShape(s.type, {});
    const keys = ['name', 'mat', 'bh', 'bhText', 'mur', 'ni', 'n', 'wnd', 'br', 'mmur', 'ang', 'h'];
    keys.forEach(k => { if (s[k] != null) t[k] = s[k]; });
    t.name = String(t.name).slice(0, 60);
    if (!MAT[t.mat]) t.mat = 'steel';
    ['mur', 'ni', 'n', 'wnd', 'br', 'mmur', 'ang', 'h'].forEach(k => { t[k] = +t[k]; if (!isFinite(t[k])) t[k] = newShape('rect', {})[k]; });
    t.n = Math.max(1, Math.round(t.n)); t.wnd = Math.max(1, Math.round(t.wnd));
    if (s.type === 'rect') { ['x0', 'y0', 'x1', 'y1'].forEach(k => t[k] = +s[k]); if (!['x0', 'y0', 'x1', 'y1'].every(k => isFinite(t[k]))) return null; }
    else if (s.type === 'circle') { ['cx', 'cy', 'r'].forEach(k => t[k] = +s[k]); if (!['cx', 'cy', 'r'].every(k => isFinite(t[k])) || t.r <= 0) return null; }
    else {
      if (!Array.isArray(s.pts) || s.pts.length < 3) return null;
      t.pts = s.pts.map(p => [+p[0], +p[1]]);
      if (t.pts.some(p => !isFinite(p[0]) || !isFinite(p[1]))) return null;
    }
    out.shapes.push(t);
  }
  return out;
}

/* ----------------------- vue, grille, aimantation ----------------------- */
const W = () => cv.clientWidth, H = () => cv.clientHeight;
const toSx = x => (x - view.cx) * view.s + W() / 2;
const toSy = y => H() / 2 - (y - view.cy) * view.s;
const toWx = sx => (sx - W() / 2) / view.s + view.cx;
const toWy = sy => (H() / 2 - sy) / view.s + view.cy;
function snap(v) { return snapOn ? +(Math.round(v / grid) * grid).toFixed(6) : +v.toFixed(4); }
function fitView() {
  let b = null;
  model.shapes.forEach(s => { const q = bboxOf(s); b = b ? [Math.min(b[0], q[0]), Math.min(b[1], q[1]), Math.max(b[2], q[2]), Math.max(b[3], q[3])] : q; });
  if (!b) b = [-60, -40, 60, 40];
  const w = Math.max(b[2] - b[0], 1), h = Math.max(b[3] - b[1], 1);
  view.cx = (b[0] + b[2]) / 2; view.cy = (b[1] + b[3]) / 2;
  view.s = Math.max(0.05, Math.min((W() - 60) / (w * 1.25), (H() - 60) / (h * 1.25)));
  invalidate();
}

/* ----------------------------- historique ----------------------------- */
function serialize() {
  return '{"depth":' + model.depth + ',"margin":' + model.margin + ',"prec":' + model.prec + ',"shapes":[\n' +
    model.shapes.map(s => JSON.stringify(s)).join(',\n') + '\n]}';
}
function persist() {
  $('projText').value = serialize();
  try { localStorage.setItem('fem2d-projet', serialize()); } catch (e) { /* stockage indisponible */ }
}
function commit() {
  hist = hist.slice(0, histPos + 1);
  hist.push(JSON.stringify(model)); histPos = hist.length - 1;
  if (hist.length > 120) { hist.shift(); histPos--; }
  if (R) { stale = true; updateBanner(); }
  persist(); updateUndoButtons(); invalidate();
}
function applyHistory(p) {
  histPos = p; model = JSON.parse(hist[p]);
  if (sel >= model.shapes.length) sel = -1;
  if (R) { stale = true; }
  syncInputs(); renderList(); buildProps(); updateBanner(); renderResults(); persist(); updateUndoButtons(); invalidate();
}
function updateUndoButtons() { $('btnUndo').disabled = histPos <= 0; $('btnRedo').disabled = histPos >= hist.length - 1; }

/* ----------------------------- couleurs ----------------------------- */
const CSS_KEYS = ['canvas', 'grid', 'grid2', 'axis', 'ink', 'ink2', 'accent', 'flux', 'meshline', 'probe', 'panel', 'line', 'warn',
  'f-steel', 's-steel', 'f-lin', 's-lin', 'f-magnet', 's-magnet', 'f-coil', 's-coil', 's-air'];
function readColors() {
  const cs = getComputedStyle(document.documentElement);
  const prev = C.canvas;
  CSS_KEYS.forEach(k => { C[k] = cs.getPropertyValue('--' + k).trim(); });
  const m = /^#([0-9a-f]{6})$/i.exec(C.canvas);
  if (m) { const n = parseInt(m[1], 16); darkCanvas = (0.2126 * (n >> 16) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255)) < 128; }
  if (prev !== C.canvas && R && R.sol) buildField();
}
function hex2rgb(h) { const n = parseInt(h.slice(1), 16); return [n >> 16, (n >> 8) & 255, n & 255]; }
const STOPS_DARK = [[0, '#0C1217'], [0.14, '#2A0F55'], [0.34, '#7B1E6E'], [0.54, '#C73E4C'], [0.74, '#F57D15'], [0.9, '#FAC52B'], [1, '#FCFFA4']];
const STOPS_LIGHT = [[0, '#F3F6F9'], [0.12, '#E3ECF2'], [0.28, '#FBE7A6'], [0.5, '#F29A4A'], [0.72, '#D23F30'], [0.88, '#8D1A52'], [1, '#34104A']];
function rampColor(t) {
  const st = darkCanvas ? STOPS_DARK : STOPS_LIGHT;
  t = clamp(t, 0, 1);
  for (let i = 1; i < st.length; i++) {
    if (t <= st[i][0]) {
      const a = hex2rgb(st[i - 1][1]), b = hex2rgb(st[i][1]), u = (t - st[i - 1][0]) / (st[i][0] - st[i - 1][0]);
      return 'rgb(' + [0, 1, 2].map(k => Math.round(a[k] + (b[k] - a[k]) * u)).join(',') + ')';
    }
  }
  return st[st.length - 1][1];
}
const NB = 96;
function niceUp(v) {
  if (!(v > 0)) return 1;
  const e = Math.pow(10, Math.floor(Math.log10(v))), m = v / e;
  const steps = [1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10];
  for (const s of steps) if (m <= s * 1.0001) return s * e;
  return 10 * e;
}
function buildField() {
  if (!R || !R.sol) return;
  const S = R.sol, M = R.mesh, m = M.tri.length / 3;
  const sorted = Float32Array.from(S.bm).sort();
  const p = sorted.length ? sorted[Math.min(sorted.length - 1, Math.floor(sorted.length * 0.995))] : 0;
  R.autoScale = niceUp(Math.max(p, 1e-12));
  R.scale = opts.bmax > 0 ? opts.bmax : R.autoScale;
  R.clipped = S.Bmax > R.scale * 1.001;
  R.colors = []; for (let b = 0; b < NB; b++) R.colors.push(rampColor((b + 0.5) / NB));
  const buckets = []; for (let b = 0; b < NB; b++) buckets.push([]);
  for (let e = 0; e < m; e++) {
    const v = (S.nbm[M.tri[3 * e]] + S.nbm[M.tri[3 * e + 1]] + S.nbm[M.tri[3 * e + 2]]) / 3;
    buckets[Math.min(NB - 1, Math.floor(clamp(v / R.scale, 0, 0.9999) * NB))].push(e);
  }
  R.buckets = buckets.map(a => Int32Array.from(a));
}
function buildIso() {
  if (R && R.sol) R.isol = F.isolines(R.mesh, R.sol.A, opts.nflux);
}

/* ------------------------------ dessin ------------------------------ */
function invalidate() { if (!raf) raf = requestAnimationFrame(() => { raf = 0; draw(); }); }
function shapePath(s) {
  ctx.beginPath();
  if (s.type === 'rect') { const b = bboxOf(s); ctx.rect(toSx(b[0]), toSy(b[3]), (b[2] - b[0]) * view.s, (b[3] - b[1]) * view.s); }
  else if (s.type === 'circle') ctx.arc(toSx(s.cx), toSy(s.cy), s.r * view.s, 0, 2 * Math.PI);
  else { s.pts.forEach((p, i) => { if (i) ctx.lineTo(toSx(p[0]), toSy(p[1])); else ctx.moveTo(toSx(p[0]), toSy(p[1])); }); ctx.closePath(); }
}
function draw() {
  const w = W(), h = H();
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  readColors();
  ctx.fillStyle = C.canvas; ctx.fillRect(0, 0, w, h);
  ctx.lineJoin = 'round'; ctx.lineCap = 'round';
  drawGrid(w, h);
  const hasField = R && R.sol && opts.field;
  if (hasField) drawField();
  if (R && (opts.mesh || !R.sol)) drawMeshLines();
  if (R && R.sol && opts.flux) drawFlux();
  drawShapes(hasField);
  if (R && R.sol && opts.vec) drawVectors(w, h);
  if (R) drawBox();
  drawProbe();
  drawDraft();
  drawHandles();
  if (hasField) drawColorbar(w);
}
function drawGrid(w, h) {
  const ladder = [0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000];
  let step = ladder.find(v => v >= grid - 1e-9 && v * view.s >= 9) || 5000;
  const x0 = toWx(0), x1 = toWx(w), y0 = toWy(h), y1 = toWy(0);
  ctx.lineWidth = 1;
  const every = Math.max(1, Math.ceil(46 / (step * 5 * view.s)));
  ctx.font = '10.5px ' + getComputedStyle(document.body).getPropertyValue('--mono');
  ctx.font = '10.5px "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace';
  ctx.fillStyle = C.ink2; ctx.textBaseline = 'top'; ctx.textAlign = 'left';
  for (let k = Math.ceil(x0 / step); k <= Math.floor(x1 / step); k++) {
    const sx = Math.round(toSx(k * step)) + 0.5, major = k % 5 === 0;
    ctx.strokeStyle = major ? C.grid2 : C.grid;
    ctx.beginPath(); ctx.moveTo(sx, 0); ctx.lineTo(sx, h); ctx.stroke();
    if (major && (k / 5) % every === 0 && sx > 140) ctx.fillText(fmm(k * step), sx + 3, 4);
  }
  ctx.textBaseline = 'alphabetic';
  for (let k = Math.ceil(y0 / step); k <= Math.floor(y1 / step); k++) {
    const sy = Math.round(toSy(k * step)) + 0.5, major = k % 5 === 0;
    ctx.strokeStyle = major ? C.grid2 : C.grid;
    ctx.beginPath(); ctx.moveTo(0, sy); ctx.lineTo(w, sy); ctx.stroke();
    if (major && (k / 5) % every === 0 && sy > 36 && sy < h - 30) ctx.fillText(fmm(k * step), 4, sy - 3);
  }
  ctx.strokeStyle = C.axis; ctx.lineWidth = 1.2;
  const ax = Math.round(toSx(0)) + 0.5, ay = Math.round(toSy(0)) + 0.5;
  if (ax >= 0 && ax <= w) { ctx.beginPath(); ctx.moveTo(ax, 0); ctx.lineTo(ax, h); ctx.stroke(); }
  if (ay >= 0 && ay <= h) { ctx.beginPath(); ctx.moveTo(0, ay); ctx.lineTo(w, ay); ctx.stroke(); }
}
function drawField() {
  const M = R.mesh, X = R.X, Y = R.Y, tri = M.tri, w = W(), h = H(), s = view.s;
  const ox = W() / 2 - view.cx * s, oy = H() / 2 + view.cy * s;
  ctx.globalAlpha = stale ? 0.3 : 1;
  ctx.lineWidth = 0.8;
  for (let b = 0; b < NB; b++) {
    const list = R.buckets[b];
    if (!list.length) continue;
    ctx.beginPath();
    for (let q = 0; q < list.length; q++) {
      const e = list[q], i = tri[3 * e], j = tri[3 * e + 1], k = tri[3 * e + 2];
      const ax = X[i] * s + ox, ay = oy - Y[i] * s, bx = X[j] * s + ox, by = oy - Y[j] * s, cx = X[k] * s + ox, cy = oy - Y[k] * s;
      if ((ax < 0 && bx < 0 && cx < 0) || (ax > w && bx > w && cx > w) || (ay < 0 && by < 0 && cy < 0) || (ay > h && by > h && cy > h)) continue;
      ctx.moveTo(ax, ay); ctx.lineTo(bx, by); ctx.lineTo(cx, cy); ctx.closePath();
    }
    ctx.fillStyle = R.colors[b]; ctx.strokeStyle = R.colors[b];
    ctx.fill(); ctx.stroke();
  }
  ctx.globalAlpha = 1;
}
function drawMeshLines() {
  const M = R.mesh, X = R.X, Y = R.Y, tri = M.tri, s = view.s, w = W(), h = H();
  const ox = w / 2 - view.cx * s, oy = h / 2 + view.cy * s;
  ctx.strokeStyle = C.meshline; ctx.lineWidth = 0.7; ctx.beginPath();
  for (let e = 0; e < tri.length; e += 3) {
    const i = tri[e], j = tri[e + 1], k = tri[e + 2];
    const ax = X[i] * s + ox, ay = oy - Y[i] * s, bx = X[j] * s + ox, by = oy - Y[j] * s, cx = X[k] * s + ox, cy = oy - Y[k] * s;
    if ((ax < 0 && bx < 0 && cx < 0) || (ax > w && bx > w && cx > w) || (ay < 0 && by < 0 && cy < 0) || (ay > h && by > h && cy > h)) continue;
    ctx.moveTo(ax, ay); ctx.lineTo(bx, by); ctx.lineTo(cx, cy); ctx.closePath();
  }
  ctx.stroke();
}
function drawFlux() {
  if (!R.isol || !R.isol.segs.length) return;
  const sg = R.isol.segs, s = view.s, ox = W() / 2 - view.cx * s, oy = H() / 2 + view.cy * s;
  ctx.globalAlpha = stale ? 0.3 : 1;
  ctx.strokeStyle = C.flux; ctx.lineWidth = 1.3; ctx.beginPath();
  for (let i = 0; i < sg.length; i += 4) {
    ctx.moveTo(sg[i] * 1000 * s + ox, oy - sg[i + 1] * 1000 * s);
    ctx.lineTo(sg[i + 2] * 1000 * s + ox, oy - sg[i + 3] * 1000 * s);
  }
  ctx.stroke(); ctx.globalAlpha = 1;
}
function drawBox() {
  const b = R.mesh.box;
  ctx.setLineDash([5, 4]); ctx.strokeStyle = C.axis; ctx.lineWidth = 1;
  ctx.strokeRect(toSx(b.x0 * 1000), toSy(b.y1 * 1000), (b.x1 - b.x0) * 1000 * view.s, (b.y1 - b.y0) * 1000 * view.s);
  ctx.setLineDash([]);
}
function matColors(s) { return { f: C['f-' + s.mat], s: C['s-' + s.mat] }; }
function drawShapes(overField) {
  model.shapes.forEach((s, i) => {
    const mc = matColors(s);
    shapePath(s);
    if (!overField) { ctx.fillStyle = s.mat === 'air' ? 'transparent' : mc.f; ctx.fill(); }
    ctx.lineWidth = i === sel ? 2.4 : 1.4;
    ctx.strokeStyle = i === sel ? C.accent : mc.s;
    if (s.mat === 'air') ctx.setLineDash([4, 3]);
    ctx.stroke(); ctx.setLineDash([]);
    const b = bboxOf(s), pw = (b[2] - b[0]) * view.s, ph = (b[3] - b[1]) * view.s;
    const c = centroidOf(s), cx = toSx(c[0]), cy = toSy(c[1]);
    if (s.mat === 'coil') {
      const r = clamp(Math.min(pw, ph) / 4, 0, 11);
      if (r > 3.5) {
        ctx.strokeStyle = C.ink; ctx.fillStyle = C.ink; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, 2 * Math.PI); ctx.stroke();
        if (s.ni >= 0) { ctx.beginPath(); ctx.arc(cx, cy, r * 0.3, 0, 2 * Math.PI); ctx.fill(); }
        else { const d = r * 0.62; ctx.beginPath(); ctx.moveTo(cx - d, cy - d); ctx.lineTo(cx + d, cy + d); ctx.moveTo(cx + d, cy - d); ctx.lineTo(cx - d, cy + d); ctx.stroke(); }
      }
    } else if (s.mat === 'magnet') {
      const L = clamp(Math.min(pw, ph) * 0.4, 0, 30);
      if (L > 8) {
        const a = (+s.ang || 0) * Math.PI / 180, dx = Math.cos(a) * L, dy = -Math.sin(a) * L;
        arrow(cx - dx, cy - dy, cx + dx, cy + dy, C.ink, 1.8, 6);
      }
    } else if (!overField && pw > 80 && ph > 26) {
      ctx.fillStyle = C.ink2; ctx.font = '11px "IBM Plex Sans", system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(s.name, cx, cy, pw - 10);
    }
  });
  ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
}
function arrow(x0, y0, x1, y1, color, lw, head) {
  const a = Math.atan2(y1 - y0, x1 - x0);
  ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = lw;
  ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(x1, y1);
  ctx.lineTo(x1 - head * Math.cos(a - 0.45), y1 - head * Math.sin(a - 0.45));
  ctx.lineTo(x1 - head * Math.cos(a + 0.45), y1 - head * Math.sin(a + 0.45)); ctx.closePath(); ctx.fill();
}
function drawVectors(w, h) {
  const sp = 30, S = R.sol, sc = R.scale;
  ctx.globalAlpha = stale ? 0.3 : 1;
  for (let sy = sp / 2; sy < h; sy += sp) for (let sx = sp / 2; sx < w; sx += sp) {
    const q = F.sampleAt(R.mesh, S, R.loc, toWx(sx) * 1e-3, toWy(sy) * 1e-3);
    if (!q || q.bm < sc * 0.02) continue;
    const L = 5 + 17 * Math.sqrt(Math.min(1, q.bm / sc)), ux = q.bx / q.bm, uy = -q.by / q.bm;
    arrow(sx - ux * L / 2, sy - uy * L / 2, sx + ux * L / 2, sy + uy * L / 2, darkCanvas ? '#E3E9EF' : '#15202B', 1.2, 4.5);
  }
  ctx.globalAlpha = 1;
}
function drawProbe() {
  if (!probe) return;
  const pts = [probe.p1].concat(probe.p2 ? [probe.p2] : []);
  if (probe.p2) {
    ctx.strokeStyle = C.probe; ctx.lineWidth = 1.5; ctx.setLineDash([6, 4]);
    ctx.beginPath(); ctx.moveTo(toSx(probe.p1[0]), toSy(probe.p1[1])); ctx.lineTo(toSx(probe.p2[0]), toSy(probe.p2[1])); ctx.stroke(); ctx.setLineDash([]);
  }
  pts.forEach((p, i) => {
    const x = toSx(p[0]), y = toSy(p[1]);
    ctx.strokeStyle = C.probe; ctx.fillStyle = C.probe; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(x, y, 5, 0, 2 * Math.PI); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x - 10, y); ctx.lineTo(x - 6, y); ctx.moveTo(x + 6, y); ctx.lineTo(x + 10, y);
    ctx.moveTo(x, y - 10); ctx.lineTo(x, y - 6); ctx.moveTo(x, y + 6); ctx.lineTo(x, y + 10); ctx.stroke();
    ctx.font = '600 11px "IBM Plex Sans", sans-serif'; ctx.fillText(i ? 'B' : 'A', x + 9, y - 8);
  });
}
function drawDraft() {
  if (!draft) return;
  ctx.strokeStyle = C.accent; ctx.lineWidth = 1.8; ctx.setLineDash([6, 4]); ctx.fillStyle = 'transparent';
  if (draft.kind === 'rect') {
    const x0 = toSx(draft.a[0]), y0 = toSy(draft.a[1]), x1 = toSx(draft.b[0]), y1 = toSy(draft.b[1]);
    ctx.strokeRect(x0, y0, x1 - x0, y1 - y0);
    dimLabel(Math.abs(draft.b[0] - draft.a[0]).toFixed(2) + ' × ' + Math.abs(draft.b[1] - draft.a[1]).toFixed(2) + ' mm', (x0 + x1) / 2, Math.min(y0, y1) - 8);
  } else if (draft.kind === 'circle') {
    const r = Math.hypot(draft.b[0] - draft.a[0], draft.b[1] - draft.a[1]);
    ctx.beginPath(); ctx.arc(toSx(draft.a[0]), toSy(draft.a[1]), r * view.s, 0, 2 * Math.PI); ctx.stroke();
    dimLabel('r = ' + r.toFixed(2) + ' mm', toSx(draft.a[0]), toSy(draft.a[1]) - r * view.s - 8);
  } else if (draft.kind === 'poly') {
    ctx.beginPath();
    draft.pts.forEach((p, i) => { if (i) ctx.lineTo(toSx(p[0]), toSy(p[1])); else ctx.moveTo(toSx(p[0]), toSy(p[1])); });
    if (draft.cur) ctx.lineTo(toSx(draft.cur[0]), toSy(draft.cur[1]));
    ctx.stroke();
    ctx.setLineDash([]); ctx.fillStyle = C.accent;
    draft.pts.forEach((p, i) => { ctx.beginPath(); ctx.arc(toSx(p[0]), toSy(p[1]), i === 0 ? 5 : 3.5, 0, 2 * Math.PI); ctx.fill(); });
  }
  ctx.setLineDash([]);
}
function dimLabel(t, x, y) {
  ctx.setLineDash([]); ctx.font = '11px "IBM Plex Mono", monospace'; ctx.textAlign = 'center';
  ctx.fillStyle = C.accent; ctx.fillText(t, x, y); ctx.textAlign = 'left';
}
function drawHandles() {
  if (tool !== 'select' || sel < 0 || !model.shapes[sel]) return;
  const rh = rotHandle();
  if (rh) {
    ctx.strokeStyle = C.accent; ctx.lineWidth = 1.4;
    ctx.beginPath(); ctx.moveTo(rh.bx, rh.by); ctx.lineTo(rh.hx, rh.hy); ctx.stroke();
    ctx.fillStyle = C.canvas; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(rh.hx, rh.hy, 7.5, 0, 2 * Math.PI); ctx.fill(); ctx.stroke();
    ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(rh.hx, rh.hy, 3.2, -0.6, 4.4); ctx.stroke();
    ctx.fillStyle = C.accent; ctx.beginPath(); ctx.moveTo(rh.hx + 4.6, rh.hy - 3.6); ctx.lineTo(rh.hx + 1.4, rh.hy - 4.2); ctx.lineTo(rh.hx + 4.2, rh.hy - 0.8); ctx.closePath(); ctx.fill();
  }
  if (drag && drag.kind === 'rot') {
    const px = toSx(drag.pivot[0]), py = toSy(drag.pivot[1]);
    ctx.strokeStyle = C.accent; ctx.lineWidth = 1.4;
    ctx.beginPath(); ctx.moveTo(px - 7, py); ctx.lineTo(px + 7, py); ctx.moveTo(px, py - 7); ctx.lineTo(px, py + 7); ctx.stroke();
    if (rh) dimLabel((drag.ang >= 0 ? '+' : '') + drag.ang.toFixed(1) + '°', rh.hx + 34, rh.hy + 4);
  }
  handlesOf(model.shapes[sel]).forEach(h => {
    const x = toSx(h.x), y = toSy(h.y);
    ctx.fillStyle = C.canvas; ctx.strokeStyle = C.accent; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.rect(x - 4.5, y - 4.5, 9, 9); ctx.fill(); ctx.stroke();
  });
}
function drawColorbar(w) {
  const x = w - 34, y = 14, hh = 120, bw = 12;
  const g = ctx.createLinearGradient(0, y + hh, 0, y);
  const n = 12; for (let i = 0; i <= n; i++) g.addColorStop(i / n, rampColor(i / n));
  ctx.fillStyle = C.canvas; ctx.globalAlpha = 0.8; ctx.fillRect(x - 58, y - 8, 96, hh + 34); ctx.globalAlpha = 1;
  ctx.fillStyle = g; ctx.fillRect(x, y, bw, hh);
  ctx.strokeStyle = C.axis; ctx.lineWidth = 1; ctx.strokeRect(x + 0.5, y + 0.5, bw, hh);
  ctx.fillStyle = C.ink2; ctx.font = '10.5px "IBM Plex Mono", monospace'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
  [0, 0.5, 1].forEach(t => ctx.fillText((t === 1 && R.clipped ? '≥ ' : '') + fnum(R.scale * t), x - 5, y + hh * (1 - t)));
  ctx.textBaseline = 'alphabetic'; ctx.textAlign = 'right'; ctx.fillText('|B| en T', x + bw, y + hh + 16);
  ctx.textAlign = 'left';
}

/* --------------------------- liste & propriétés --------------------------- */
function renderList() {
  const ul = $('shapeList'); ul.innerHTML = '';
  if (!model.shapes.length) { const li = document.createElement('li'); li.className = 'empty'; li.textContent = 'Aucune région. Choisissez un outil de dessin.'; ul.appendChild(li); return; }
  model.shapes.forEach((s, i) => {
    const li = document.createElement('li'), b = document.createElement('button');
    b.type = 'button'; if (i === sel) b.setAttribute('aria-current', 'true');
    const sw = document.createElement('span'); sw.className = 'sw'; sw.style.background = 'var(--f-' + s.mat + ')'; sw.style.borderColor = 'var(--s-' + s.mat + ')';
    const nm = document.createElement('span'); nm.className = 'nm'; nm.textContent = s.name;
    const mt = document.createElement('span'); mt.className = 'mt'; mt.textContent = MAT[s.mat].label;
    b.append(sw, nm, mt);
    b.addEventListener('click', () => { selectShape(i); });
    li.appendChild(b); ul.appendChild(li);
  });
}
function selectShape(i) { sel = i; renderList(); buildProps(); renderResults(); invalidate(); }
function fld(label, id, type, val, cls, extra) {
  return '<label class="f ' + (cls || '') + '"><span>' + label + '</span><input type="' + type + '" id="' + id + '" value="' + esc(val) + '" ' + (extra || '') + '></label>';
}
function buildProps() {
  const el = $('props');
  const s = model.shapes[sel];
  if (!s) { el.innerHTML = '<p class="empty">Sélectionnez une région, ou dessinez-en une avec les outils Rectangle, Cercle ou Polygone. Un exemple se charge depuis la liste de la barre d\'outils.</p>'; return; }
  let h = '<div class="g2">';
  h += fld('Nom', 'pName', 'text', s.name, 'wide', 'maxlength="60"');
  h += '<label class="f wide"><span>Matériau</span><select id="pMat">' + Object.keys(MAT).map(k => '<option value="' + k + '"' + (k === s.mat ? ' selected' : '') + '>' + MAT[k].label + '</option>').join('') + '</select></label>';
  if (s.mat === 'lin') h += fld('Perméabilité relative μr', 'pMur', 'number', s.mur, 'wide', 'min="1" step="any"');
  if (s.mat === 'steel') {
    h += '<label class="f wide"><span>Courbe B(H)</span><select id="pBh"><option value="acier">' + F.BH_PRESETS.acier.label + '</option><option value="fesi">' + F.BH_PRESETS.fesi.label + '</option><option value="perso">Table personnalisée</option></select></label>';
    if (s.bh === 'perso') h += '<label class="f wide"><span>Table : une ligne « B (T)  H (A/m) », B croissant</span><textarea id="pBhText" rows="6" spellcheck="false">' + esc(s.bhText) + '</textarea></label>';
  }
  if (s.mat === 'magnet') {
    h += fld('Induction rémanente Br (T)', 'pBr', 'number', s.br, '', 'step="any"');
    h += fld('μr de l\'aimant', 'pMmur', 'number', s.mmur, '', 'min="0.5" step="any"');
    h += fld('Direction (°)', 'pAng', 'number', s.ang, 'wide', 'step="any"');
  }
  if (s.mat === 'coil') {
    h += fld('Bobinage n°', 'pWnd', 'number', s.wnd, '', 'min="1" step="1"') + fld('Spires N', 'pN', 'number', s.n, '', 'min="1" step="1"');
    h += fld('Courant I (A)', 'pI', 'number', +(s.ni / Math.max(1, s.n)).toPrecision(6), 'wide', 'step="any"');
    const A = areaOf(s);
    h += '<p class="note wide" style="grid-column:1/-1;margin:0">N·I = ' + fnum(s.ni) + ' A·tours dans cette région, soit ≈ ' + fnum(s.ni / Math.max(A, 1e-9)) + ' A/mm². Courant positif : sortant du plan (⊙), négatif : entrant (⊗). Les régions de même bobinage (aller, retour) portent chacune N·I, avec des signes opposés.</p>';
  }
  if (s.type === 'rect') {
    h += fld('X min (mm)', 'pX0', 'number', fmm(Math.min(s.x0, s.x1)), '', 'step="any"') + fld('Y min (mm)', 'pY0', 'number', fmm(Math.min(s.y0, s.y1)), '', 'step="any"');
    h += fld('X max (mm)', 'pX1', 'number', fmm(Math.max(s.x0, s.x1)), '', 'step="any"') + fld('Y max (mm)', 'pY1', 'number', fmm(Math.max(s.y0, s.y1)), '', 'step="any"');
  } else if (s.type === 'circle') {
    h += fld('Centre X (mm)', 'pCx', 'number', fmm(s.cx), '', 'step="any"') + fld('Centre Y (mm)', 'pCy', 'number', fmm(s.cy), '', 'step="any"');
    h += fld('Rayon (mm)', 'pR', 'number', fmm(s.r), 'wide', 'min="0.001" step="any"');
  } else {
    h += '<label class="f wide"><span>Sommets (mm), une ligne « x y »</span><textarea id="pPts" rows="5" spellcheck="false">' + esc(s.pts.map(p => fmm(p[0]) + ' ' + fmm(p[1])).join('\n')) + '</textarea></label>';
  }
  h += '<div class="sub" style="grid-column:1/-1;margin-bottom:0">Rotation</div>';
  h += fld('Angle (°)', 'pRotAng', 'number', rotUI.ang, '', 'step="any"');
  h += '<label class="f"><span>Centre</span><select id="pRotC"><option value="self">Centre de la région</option><option value="origin">Origine (0 ; 0)</option><option value="point">Point précis</option></select></label>';
  if (rotUI.c === 'point') h += fld('Centre X (mm)', 'pRotX', 'number', rotUI.x, '', 'step="any"') + fld('Centre Y (mm)', 'pRotY', 'number', rotUI.y, '', 'step="any"');
  h += '<div class="row" style="grid-column:1/-1"><button class="btn small" id="pRotL" type="button">↺ Antihoraire</button><button class="btn small" id="pRotR" type="button">↻ Horaire</button></div>';
  h += '<p class="note" style="grid-column:1/-1;margin:0">' + (s.mat === 'magnet' ? 'La direction d\'aimantation tourne avec la région. ' : '') + (s.type === 'rect' ? 'Un rectangle tourné d\'un angle qui n\'est pas un multiple de 90° devient un polygone. ' : '') + 'Sur le plan de travail, la poignée ronde au-dessus de la région tourne par pas de 5° si l\'aimantation est active.</p>';
  h += fld('Maille locale (mm), 0 = auto', 'pH', 'number', s.h || 0, 'wide', 'min="0" step="any"');
  h += '</div><div class="row" style="margin-top:8px"><button class="btn small" id="pUp" type="button">Mettre au-dessus</button><button class="btn small" id="pDown" type="button">Mettre en dessous</button></div>';
  if (s.type === 'poly') h += '<p class="note">Double-clic sur un côté pour ajouter un sommet, sur un sommet pour le supprimer.</p>';
  el.innerHTML = h;
  const bhSel = $('pBh'); if (bhSel) bhSel.value = s.bh;
  $('pRotC').value = rotUI.c;
  const num = (id, apply) => {
    const e = $(id); if (!e) return;
    e.addEventListener('change', () => {
      const v = parseFloat(String(e.value).replace(',', '.'));
      if (!isFinite(v)) { buildProps(); return; }
      apply(v); commit(); renderList(); buildProps();
    });
  };
  $('pName').addEventListener('change', e => { s.name = e.target.value.trim() || 'Région'; commit(); renderList(); });
  $('pMat').addEventListener('change', e => { s.mat = e.target.value; commit(); renderList(); buildProps(); });
  num('pMur', v => s.mur = Math.max(1, v));
  if (bhSel) bhSel.addEventListener('change', e => { s.bh = e.target.value; commit(); buildProps(); });
  const bt = $('pBhText');
  if (bt) bt.addEventListener('change', e => {
    s.bhText = e.target.value;
    if (!F.parseBH(s.bhText)) showBanner('Table B(H) illisible : il faut au moins deux lignes « B H ». La courbe générique est utilisée.', 'warn');
    commit();
  });
  num('pBr', v => s.br = v); num('pMmur', v => s.mmur = Math.max(0.5, v)); num('pAng', v => s.ang = v);
  num('pWnd', v => s.wnd = Math.max(1, Math.round(v)));
  num('pN', v => { const I = s.ni / Math.max(1, s.n); s.n = Math.max(1, Math.round(v)); s.ni = I * s.n; });
  num('pI', v => { s.ni = v * Math.max(1, s.n); });
  num('pX0', v => { const b = bboxOf(s); s.x0 = v; s.x1 = b[2]; s.y0 = b[1]; s.y1 = b[3]; });
  num('pY0', v => { const b = bboxOf(s); s.y0 = v; s.y1 = b[3]; s.x0 = b[0]; s.x1 = b[2]; });
  num('pX1', v => { const b = bboxOf(s); s.x1 = v; s.x0 = b[0]; s.y0 = b[1]; s.y1 = b[3]; });
  num('pY1', v => { const b = bboxOf(s); s.y1 = v; s.x0 = b[0]; s.x1 = b[2]; s.y0 = b[1]; });
  num('pCx', v => s.cx = v); num('pCy', v => s.cy = v); num('pR', v => s.r = Math.max(0.001, v));
  num('pH', v => s.h = Math.max(0, v));
  const readAng = () => { const e = $('pRotAng'), v = parseFloat(String(e.value).replace(',', '.')); if (isFinite(v)) rotUI.ang = v; e.value = rotUI.ang; return rotUI.ang; };
  $('pRotAng').addEventListener('change', readAng);
  $('pRotC').addEventListener('change', e => { rotUI.c = e.target.value; buildProps(); });
  [['pRotX', 'x'], ['pRotY', 'y']].forEach(k => { const e = $(k[0]); if (e) e.addEventListener('change', () => { const v = parseFloat(String(e.value).replace(',', '.')); if (isFinite(v)) rotUI[k[1]] = v; e.value = rotUI[k[1]]; }); });
  $('pRotL').addEventListener('click', () => {
    ['pRotX', 'pRotY'].forEach(id => { const e = $(id); if (e) { const v = parseFloat(String(e.value).replace(',', '.')); if (isFinite(v)) rotUI[id === 'pRotX' ? 'x' : 'y'] = v; } });
    applyRotation(readAng());
  });
  $('pRotR').addEventListener('click', () => {
    ['pRotX', 'pRotY'].forEach(id => { const e = $(id); if (e) { const v = parseFloat(String(e.value).replace(',', '.')); if (isFinite(v)) rotUI[id === 'pRotX' ? 'x' : 'y'] = v; } });
    applyRotation(-readAng());
  });
  const pp = $('pPts');
  if (pp) pp.addEventListener('change', e => {
    const pts = e.target.value.split(/\n+/).map(l => l.trim().replace(/,/g, '.').split(/[\s;]+/).map(Number)).filter(p => p.length >= 2 && isFinite(p[0]) && isFinite(p[1])).map(p => [p[0], p[1]]);
    if (pts.length >= 3) { s.pts = pts; commit(); } else showBanner('Un polygone demande au moins trois sommets.', 'warn');
    buildProps();
  });
  $('pUp').addEventListener('click', () => { if (sel < model.shapes.length - 1) { [model.shapes[sel], model.shapes[sel + 1]] = [model.shapes[sel + 1], model.shapes[sel]]; sel++; commit(); renderList(); buildProps(); } });
  $('pDown').addEventListener('click', () => { if (sel > 0) { [model.shapes[sel], model.shapes[sel - 1]] = [model.shapes[sel - 1], model.shapes[sel]]; sel--; commit(); renderList(); buildProps(); } });
}

/* ------------------------------- bannière ------------------------------- */
function showBanner(msg, kind, withRun) {
  const b = $('banner'); b.className = 'banner' + (kind === 'err' ? ' err' : ''); b.hidden = false;
  b.innerHTML = '<span>' + esc(msg) + '</span>' + (withRun ? '<button class="btn small primary" id="bnRun" type="button">Recalculer</button>' : '<button class="btn small" id="bnClose" type="button" aria-label="Fermer">×</button>');
  const r = $('bnRun'); if (r) r.addEventListener('click', runSolve);
  const c = $('bnClose'); if (c) c.addEventListener('click', () => { b.hidden = true; });
}
function updateBanner() {
  if (stale && R) showBanner('La géométrie a changé : les résultats ne sont plus à jour.', 'warn', true);
  else $('banner').hidden = true;
}
function setStatus(t) { $('status').textContent = t; }

/* ------------------------------- calcul ------------------------------- */
function hasSource() { return model.shapes.some(s => (s.mat === 'coil' && +s.ni !== 0) || (s.mat === 'magnet' && +s.br !== 0)); }
function prepareMeshView(mesh) {
  const n = mesh.px.length, X = new Float64Array(n), Y = new Float64Array(n);
  for (let i = 0; i < n; i++) { X[i] = mesh.px[i] * 1000; Y[i] = mesh.py[i] * 1000; }
  return { X, Y };
}
const nextFrame = () => new Promise(r => setTimeout(r, 15));
async function runSolve(onlyMesh) {
  if (busy) return;
  if (onlyMesh !== true) onlyMesh = false;
  if (!model.shapes.length) { showBanner('Dessinez au moins une région avant de lancer le calcul.', 'warn'); return; }
  if (!onlyMesh && !hasSource()) { showBanner('Aucune source : donnez des ampères-tours non nuls à une bobine, ou ajoutez un aimant.', 'warn'); return; }
  busy = true; $('btnRun').disabled = true; $('btnMesh').disabled = true;
  $('banner').hidden = true;
  const snapshot = JSON.parse(JSON.stringify(model));
  try {
    setStatus('Maillage en cours…'); await nextFrame();
    const t0 = performance.now();
    const mesh = F.generateMesh(snapshot, { prec: snapshot.prec });
    const tMesh = performance.now() - t0;
    const mv = prepareMeshView(mesh);
    if (onlyMesh) {
      R = { mesh, sol: null, loc: null, model: snapshot, X: mv.X, Y: mv.Y }; stale = false;
      setStatus('Maillage : ' + mesh.meta.nodes + ' nœuds, ' + mesh.meta.elems + ' éléments (' + Math.round(tMesh) + ' ms)');
    } else {
      setStatus('Résolution…'); await nextFrame();
      const sol = await F.solve(snapshot, mesh, { progress: p => setStatus(p.phase + ' : résidu ' + p.res.toExponential(1)) });
      const loc = F.makeLocator(mesh);
      R = { mesh, sol, loc, model: snapshot, X: mv.X, Y: mv.Y, force: {}, ind: null };
      stale = false; buildField(); buildIso();
      setStatus('Calcul terminé en ' + Math.round(tMesh + sol.timeMs) + ' ms (' + mesh.meta.nodes + ' nœuds)');
      if (probe && !probe.keep) { /* la sonde reste valable */ }
      if (sol.residual > 1e-4) showBanner('Le calcul non linéaire n\'a pas atteint la tolérance (résidu ' + sol.residual.toExponential(1) + '). Vérifiez la courbe B(H) ou réduisez les ampères-tours.', 'warn');
    }
  } catch (err) {
    console.error(err);
    showBanner(String(err && err.message || err), 'err');
    setStatus('Échec du calcul');
  }
  busy = false; $('btnRun').disabled = false; $('btnMesh').disabled = false;
  renderResults(); invalidate();
}

/* ------------------------------ résultats ------------------------------ */
function regionStats() {
  const M = R.mesh, S = R.sol, m = M.tri.length / 3, nReg = R.model.shapes.length + 1;
  const area = new Float64Array(nReg), sumB = new Float64Array(nReg), maxB = new Float64Array(nReg);
  for (let e = 0; e < m; e++) {
    const i = M.tri[3 * e], j = M.tri[3 * e + 1], k = M.tri[3 * e + 2];
    const a = Math.abs((M.px[j] - M.px[i]) * (M.py[k] - M.py[i]) - (M.px[k] - M.px[i]) * (M.py[j] - M.py[i])) / 2;
    const r = M.reg[e] + 1;
    area[r] += a; sumB[r] += a * S.bm[e]; if (S.bm[e] > maxB[r]) maxB[r] = S.bm[e];
  }
  return { area, sumB, maxB };
}
function sampleLine(p1, p2, n) {
  const out = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n, x = p1[0] + (p2[0] - p1[0]) * t, y = p1[1] + (p2[1] - p1[1]) * t;
    const q = F.sampleAt(R.mesh, R.sol, R.loc, x * 1e-3, y * 1e-3);
    out.push({ d: Math.hypot(x - p1[0], y - p1[1]), b: q ? q.bm : NaN });
  }
  return out;
}
function renderResults() {
  const el = $('results');
  if (!R) { el.innerHTML = '<p class="empty">Aucun calcul pour l\'instant. Dessinez la géométrie puis lancez « Calculer ».</p>'; return; }
  const M = R.mesh, S = R.sol;
  let h = '<dl class="kv">';
  const kv = (k, v) => { h += '<dt>' + k + '</dt><dd>' + v + '</dd>'; };
  kv('Nœuds / éléments', M.meta.nodes + ' / ' + M.meta.elems);
  if (M.meta.gap < Infinity) kv('Plus petit entrefer', fnum(M.meta.gap * 1000) + ' mm');
  if (S) {
    kv('|B| maximal', fnum(S.Bmax) + ' T');
    if (!R.model.shapes.some(s => s.mat === 'magnet')) kv('Énergie magnétique', fnum(S.Wtot) + ' J');
    kv('Itérations CG', S.iters + (S.nonlinear ? ' (Newton ' + S.newton + ')' : ''));
    kv('Résidu', S.residual.toExponential(1));
  }
  h += '</dl>';
  if (S) {
    (S.warnings || []).forEach(w => { h += '<p class="warn">' + esc(w) + '</p>'; });
    const st = regionStats();
    h += '<div class="sub">Par région</div><div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="color:var(--ink2);text-align:right"><th style="text-align:left;font-weight:500;padding:2px 4px 2px 0">Région</th><th style="font-weight:500;padding:2px 4px">B moy. (T)</th><th style="font-weight:500;padding:2px 0 2px 4px">B max (T)</th></tr></thead><tbody>';
    const rows = [[0, 'Air']].concat(R.model.shapes.map((s, i) => [i + 1, s.name]));
    rows.forEach(r => {
      const a = st.area[r[0]];
      if (!(a > 0)) return;
      h += '<tr style="border-top:1px solid var(--line)"><td style="padding:2px 4px 2px 0;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(r[1]) + '</td><td style="text-align:right;font-family:var(--mono);padding:2px 4px">' + fnum(st.sumB[r[0]] / a) + '</td><td style="text-align:right;font-family:var(--mono);padding:2px 0 2px 4px">' + fnum(st.maxB[r[0]]) + '</td></tr>';
    });
    h += '</tbody></table></div>';
    const wd = F.windingFlux(R.model, M, S);
    if (wd.length) {
      const th = 'style="font-weight:500;padding:2px 4px;text-align:right"', td = 'style="text-align:right;font-family:var(--mono);padding:2px 4px"';
      h += '<div class="sub">Bobinages</div><div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="color:var(--ink2)"><th style="font-weight:500;padding:2px 4px 2px 0;text-align:left">N°</th><th ' + th + '>Spires</th><th ' + th + '>I (A)</th><th ' + th + '>λ (Wb)</th><th ' + th + '>λ/I (mH)</th></tr></thead><tbody>';
      wd.forEach(w => {
        h += '<tr style="border-top:1px solid var(--line)"><td style="padding:2px 4px 2px 0">' + w.id + '</td><td ' + td + '>' + w.N + '</td><td ' + td + '>' + fnum(w.I) + '</td><td ' + td + '>' + fnum(w.lambda) + '</td><td ' + td + '>' + fnum(w.lambda / w.I * 1e3) + '</td></tr>';
      });
      h += '</tbody></table></div>';
      wd.forEach(w => w.warn.forEach(x => { h += '<p class="warn">Bobinage ' + w.id + ' : ' + x + '.</p>'; }));
      h += '<p class="note">λ = N · profondeur · (A moyen sur l\'aller − A moyen sur le retour), flux total de toutes les sources. λ/I vaut l\'inductance propre si ce bobinage est la seule source.</p>';
      if (!stale) {
        h += '<div class="row" style="margin-top:6px"><button class="btn small" type="button" data-act="ind">' + (R.ind ? 'Recalculer' : 'Calculer') + ' la matrice d\'inductances</button></div>';
        if (R.ind) {
          const ids = R.ind.ids;
          h += '<div style="overflow-x:auto;margin-top:6px"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="color:var(--ink2)"><th style="font-weight:500;padding:2px 4px 2px 0;text-align:left">mH</th>' + ids.map(i => '<th ' + th + '>' + i + '</th>').join('') + '</tr></thead><tbody>';
          ids.forEach((id, i) => { h += '<tr style="border-top:1px solid var(--line)"><td style="padding:2px 4px 2px 0">' + id + '</td>' + ids.map((_, j) => '<td ' + td + '>' + fnum(R.ind.L[i][j] * 1e3) + '</td>').join('') + '</tr>'; });
          h += '</tbody></table></div><p class="note">Diagonale : inductances propres. Hors diagonale : mutuelles. Chaque colonne vient d\'un calcul où seul ce bobinage est alimenté' + (R.ind.secant ? ' ; aimants éteints. Matériaux saturables : valeurs sécantes à ce niveau de courant' : (R.model.shapes.some(s => s.mat === 'magnet') ? ' ; aimants éteints' : '')) + '.</p>';
        }
      }
    }
    h += '<div class="sub">Efforts sur la région sélectionnée</div>';
    const s = model.shapes[sel];
    if (!s) h += '<p class="note" style="margin:0">Sélectionnez une région entourée d\'air.</p>';
    else if (stale) h += '<p class="note" style="margin:0">Recalculez pour obtenir les efforts.</p>';
    else {
      h += '<div class="row"><button class="btn small" type="button" data-act="force">Calculer pour « ' + esc(s.name.length > 22 ? s.name.slice(0, 21) + '…' : s.name) + ' »</button></div>';
      const f = R.force && R.force[sel];
      if (f === null) h += '<p class="warn">Pas de contour d\'air continu autour de cette région : les pièces voisines sont trop proches, en contact ou se chevauchent.</p>';
      else if (f) {
        h += '<dl class="kv" style="margin-top:6px">';
        kv('Fx', fnum(f.Fx) + ' N'); kv('Fy', fnum(f.Fy) + ' N'); kv('Couple', fnum(f.T) + ' N·m');
        h += '</dl><p class="note">Tenseur de Maxwell, moyenne sur 9 contours dans l\'air, profondeur ' + fmm(R.model.depth) + ' mm. Dispersion : ±' + fnum(Math.max(f.dFx, f.dFy) / 2) + ' N. Couple autour du centre de la région.</p>';
      }
    }
    if (probe) {
      const q = F.sampleAt(M, S, R.loc, probe.p1[0] * 1e-3, probe.p1[1] * 1e-3);
      h += '<div class="sub">Sonde</div><dl class="kv">';
      const row = (name, p) => {
        const z = F.sampleAt(M, S, R.loc, p[0] * 1e-3, p[1] * 1e-3);
        if (!z) { kv(name + ' (' + fmm(p[0]) + ' ; ' + fmm(p[1]) + ')', 'hors domaine'); return null; }
        kv(name + ' (' + fmm(p[0]) + ' ; ' + fmm(p[1]) + ') mm', '|B| = ' + fnum(z.bm) + ' T');
        kv('Bx / By', fnum(z.bx) + ' / ' + fnum(z.by) + ' T');
        kv('H = ν|B|', fnum(z.nu * z.bm) + ' A/m');
        kv('Potentiel A', fnum(z.A) + ' Wb/m');
        const rg = z.reg >= 0 ? R.model.shapes[z.reg].name : 'Air';
        kv('Région', esc(rg));
        return z;
      };
      const za = row('A', probe.p1);
      if (probe.p2) {
        const zb = row('B', probe.p2);
        if (za && zb) kv('Flux A→B, positif vers la droite', fnum((zb.A - za.A) * R.sol.depth) + ' Wb');
      }
      h += '</dl>';
      if (probe.p2) h += '<canvas class="prof" id="profCv" aria-label="Profil de |B| le long du segment"></canvas><p class="note">|B| le long du segment A→B.</p>';
      void q;
    }
  }
  el.innerHTML = h;
  if (S && probe && probe.p2) drawProfile();
}
async function computeInductances() {
  if (busy || !R || !R.sol || stale) return;
  const ref = R.model, wd = F.windingFlux(ref, R.mesh, R.sol);
  if (!wd.length) return;
  busy = true; $('btnRun').disabled = true;
  const ids = wd.map(w => w.id), n = ids.length, L = ids.map(() => new Array(n).fill(0));
  try {
    for (let j = 0; j < n; j++) {
      setStatus('Inductances : bobinage ' + ids[j] + ' (' + (j + 1) + '/' + n + ')…'); await nextFrame();
      const v = JSON.parse(JSON.stringify(ref));
      v.shapes.forEach(s => {
        if (s.mat === 'magnet') s.br = 0;
        if (s.mat === 'coil' && Math.max(1, Math.round(+s.wnd || 1)) !== ids[j]) s.ni = 0;
      });
      const so = await F.solve(v, R.mesh, {});
      F.windingFlux(ref, R.mesh, so).forEach(w => { L[ids.indexOf(w.id)][j] = w.lambda / wd[j].I; });
    }
    R.ind = { ids, L, secant: !!R.sol.nonlinear };
    setStatus('Matrice d\'inductances calculée.');
  } catch (err) { console.error(err); showBanner(String(err && err.message || err), 'err'); }
  busy = false; $('btnRun').disabled = false;
  renderResults();
}
function drawProfile() {
  const c = $('profCv'); if (!c) return;
  const w = c.clientWidth, hh = c.clientHeight, d = Math.min(2, window.devicePixelRatio || 1);
  c.width = w * d; c.height = hh * d;
  const g = c.getContext('2d'); g.setTransform(d, 0, 0, d, 0, 0);
  const data = sampleLine(probe.p1, probe.p2, 160), L = data[data.length - 1].d || 1;
  let mx = 0; data.forEach(p => { if (isFinite(p.b) && p.b > mx) mx = p.b; });
  mx = niceUp(mx || 1);
  const pl = 38, pr = 8, pt = 8, pb = 20, pw = w - pl - pr, ph = hh - pt - pb;
  g.font = '10px "IBM Plex Mono", monospace'; g.fillStyle = C.ink2; g.strokeStyle = C.grid2; g.lineWidth = 1;
  [0, 0.5, 1].forEach(t => { const y = pt + ph * (1 - t); g.beginPath(); g.moveTo(pl, y + 0.5); g.lineTo(pl + pw, y + 0.5); g.stroke(); g.textAlign = 'right'; g.textBaseline = 'middle'; g.fillText(fnum(mx * t), pl - 4, y); });
  g.textAlign = 'center'; g.textBaseline = 'top';
  g.fillText('0', pl, hh - pb + 5); g.fillText(fmm(L) + ' mm', pl + pw - 14, hh - pb + 5);
  g.strokeStyle = C.probe; g.lineWidth = 1.8; g.beginPath();
  let pen = false;
  data.forEach(p => {
    if (!isFinite(p.b)) { pen = false; return; }
    const x = pl + pw * p.d / L, y = pt + ph * (1 - p.b / mx);
    if (pen) g.lineTo(x, y); else g.moveTo(x, y); pen = true;
  });
  g.stroke();
}

/* ------------------------------- entrées ------------------------------- */
function syncInputs() {
  $('inPrec').value = model.prec; $('precTxt').textContent = PREC_NAMES[model.prec];
  $('inDepth').value = model.depth; $('inMargin').value = model.margin;
  $('inNflux').value = opts.nflux; $('nfluxTxt').textContent = opts.nflux;
  $('inGrid').value = String(grid); $('inSnap').checked = snapOn;
}
function setTool(t) {
  tool = t; draft = null;
  document.querySelectorAll('[data-tool]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tool === t)));
  $('hint').textContent = HINTS[t];
  stage.querySelector('canvas').style.cursor = t === 'select' ? 'default' : 'crosshair';
  invalidate();
}
function loadModel(m, label) {
  model = m; sel = -1; R = null; stale = false; probe = null; draft = null;
  syncInputs(); renderList(); buildProps(); renderResults(); $('banner').hidden = true;
  commit(); fitView(); if (label) setStatus(label);
}
function evPos(e) { const r = cv.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; }
function snapPt(sx, sy) { return [snap(toWx(sx)), snap(toWy(sy))]; }
function hitHandle(sx, sy) {
  const s = model.shapes[sel]; if (!s) return null;
  let best = null, bd = 11;
  handlesOf(s).forEach(h => { const d = Math.hypot(toSx(h.x) - sx, toSy(h.y) - sy); if (d < bd) { bd = d; best = h; } });
  return best;
}
function topShapeAt(x, y) { for (let i = model.shapes.length - 1; i >= 0; i--) if (hitShape(model.shapes[i], x, y)) return i; return -1; }

cv.addEventListener('pointerdown', e => {
  cv.setPointerCapture(e.pointerId);
  const [sx, sy] = evPos(e);
  pointers.set(e.pointerId, [sx, sy]);
  if (pointers.size === 2) {
    const p = [...pointers.values()];
    pinch = { d: Math.hypot(p[0][0] - p[1][0], p[0][1] - p[1][1]), c: [(p[0][0] + p[1][0]) / 2, (p[0][1] + p[1][1]) / 2] };
    drag = null; draft = tool === 'poly' ? draft : null; return;
  }
  const panBtn = e.button === 1 || e.button === 2 || spaceDown;
  if (panBtn) { drag = { kind: 'pan', sx, sy, cx: view.cx, cy: view.cy }; return; }
  const wp = [toWx(sx), toWy(sy)];
  if (tool === 'select') {
    const rh = rotHandle();
    if (rh && Math.hypot(rh.hx - sx, rh.hy - sy) < 12) {
      const s0 = model.shapes[sel], pv = centroidOf(s0);
      drag = { kind: 'rot', pivot: pv, a0: Math.atan2(wp[1] - pv[1], wp[0] - pv[0]), orig: cloneShape(s0), moved: false, ang: 0 };
      return;
    }
    const hh = hitHandle(sx, sy);
    if (hh) {
      const s = model.shapes[sel];
      drag = { kind: 'handle', h: hh, orig: cloneShape(s), moved: false, opp: s.type === 'rect' ? (() => { const b = bboxOf(s), o = handlesOf(s)[(hh.idx + 2) % 4]; return [o.x, o.y]; })() : null };
      return;
    }
    const i = topShapeAt(wp[0], wp[1]);
    if (i >= 0) { if (i !== sel) selectShape(i); drag = { kind: 'move', start: snapPt(sx, sy), orig: cloneShape(model.shapes[i]), moved: false }; }
    else { if (sel >= 0) selectShape(-1); drag = { kind: 'pan', sx, sy, cx: view.cx, cy: view.cy }; }
  } else if (tool === 'rect' || tool === 'circle') {
    const p = snapPt(sx, sy); draft = { kind: tool, a: p, b: p, sx, sy };
  } else if (tool === 'poly') {
    const p = snapPt(sx, sy);
    if (!draft) draft = { kind: 'poly', pts: [p], cur: p };
    else {
      const f = draft.pts[0];
      if (draft.pts.length >= 3 && Math.hypot(toSx(f[0]) - sx, toSy(f[1]) - sy) < 10) { finishPoly(); return; }
      const l = draft.pts[draft.pts.length - 1];
      if (l[0] !== p[0] || l[1] !== p[1]) draft.pts.push(p);
    }
    invalidate();
  } else if (tool === 'probe') {
    const p = [+toWx(sx).toFixed(3), +toWy(sy).toFixed(3)];
    probe = { p1: p, p2: null }; drag = { kind: 'probe', sx, sy };
    if (!R || !R.sol) setStatus('Lancez un calcul pour utiliser la sonde.');
    renderResults(); invalidate();
  }
});
cv.addEventListener('pointermove', e => {
  const [sx, sy] = evPos(e);
  if (pointers.has(e.pointerId)) pointers.set(e.pointerId, [sx, sy]);
  if (pinch && pointers.size === 2) {
    const p = [...pointers.values()], d = Math.hypot(p[0][0] - p[1][0], p[0][1] - p[1][1]), c = [(p[0][0] + p[1][0]) / 2, (p[0][1] + p[1][1]) / 2];
    const wx = toWx(pinch.c[0]), wy = toWy(pinch.c[1]);
    view.s = clamp(view.s * d / Math.max(pinch.d, 1), 0.02, 400);
    view.cx = wx - (c[0] - W() / 2) / view.s; view.cy = wy + (c[1] - H() / 2) / view.s;
    pinch = { d, c }; invalidate(); return;
  }
  const wx = toWx(sx), wy = toWy(sy);
  cursorMM = [wx, wy];
  let txt = 'x ' + wx.toFixed(2) + '   y ' + wy.toFixed(2) + ' mm';
  if (R && R.sol && !stale) { const q = F.sampleAt(R.mesh, R.sol, R.loc, wx * 1e-3, wy * 1e-3); if (q) txt += '   |B| ' + fnum(q.bm) + ' T'; }
  $('coords').textContent = txt;
  if (draft && draft.kind === 'poly') { draft.cur = snapPt(sx, sy); invalidate(); }
  if (draft && (draft.kind === 'rect' || draft.kind === 'circle')) { draft.b = snapPt(sx, sy); invalidate(); }
  if (!drag) return;
  if (drag.kind === 'pan') { view.cx = drag.cx - (sx - drag.sx) / view.s; view.cy = drag.cy + (sy - drag.sy) / view.s; invalidate(); }
  else if (drag.kind === 'move') {
    const p = snapPt(sx, sy), s = model.shapes[sel];
    const dx = p[0] - drag.start[0], dy = p[1] - drag.start[1];
    if (dx || dy) { drag.moved = true; moveShape(s, drag.orig, dx, dy); invalidate(); }
  } else if (drag.kind === 'rot') {
    let a = Math.atan2(wy - drag.pivot[1], wx - drag.pivot[0]) - drag.a0;
    while (a > Math.PI) a -= 2 * Math.PI; while (a <= -Math.PI) a += 2 * Math.PI;
    const st = (snapOn ? 5 : 0.1) * Math.PI / 180;
    a = Math.round(a / st) * st;
    drag.ang = +(a * 180 / Math.PI).toFixed(3);
    if (Math.abs(a) > 1e-12 || drag.moved) { drag.moved = true; model.shapes[sel] = rotatedShape(drag.orig, a, drag.pivot); }
    invalidate();
  } else if (drag.kind === 'handle') {
    const s = model.shapes[sel], p = snapPt(sx, sy);
    drag.moved = true;
    if (drag.h.kind === 'corner') { s.x0 = drag.opp[0]; s.y0 = drag.opp[1]; s.x1 = p[0]; s.y1 = p[1]; }
    else if (drag.h.kind === 'radius') s.r = Math.max(0.01, +Math.hypot(p[0] - s.cx, p[1] - s.cy).toFixed(4));
    else s.pts[drag.h.idx] = p;
    invalidate();
  } else if (drag.kind === 'probe') {
    if (Math.hypot(sx - drag.sx, sy - drag.sy) > 5) { probe.p2 = [+wx.toFixed(3), +wy.toFixed(3)]; invalidate(); }
  }
});
function endPointer(e) {
  pointers.delete(e.pointerId);
  if (pointers.size < 2) pinch = null;
  const [sx, sy] = evPos(e);
  if (drag && (drag.kind === 'move' || drag.kind === 'handle' || drag.kind === 'rot')) {
    if (drag.moved) {
      const s = model.shapes[sel];
      if (s.type === 'rect' && drag.kind === 'handle') { const b = bboxOf(s); s.x0 = b[0]; s.y0 = b[1]; s.x1 = b[2]; s.y1 = b[3]; }
      commit(); renderList(); buildProps(); renderResults();
    }
  } else if (drag && drag.kind === 'probe') { renderResults(); }
  drag = null;
  if (draft && (draft.kind === 'rect' || draft.kind === 'circle')) {
    const d = draft; draft = null;
    const moved = Math.hypot(sx - d.sx, sy - d.sy) > 5;
    if (moved && d.kind === 'rect' && d.a[0] !== d.b[0] && d.a[1] !== d.b[1]) {
      addShape(newShape('rect', { x0: Math.min(d.a[0], d.b[0]), y0: Math.min(d.a[1], d.b[1]), x1: Math.max(d.a[0], d.b[0]), y1: Math.max(d.a[1], d.b[1]) }));
    } else if (moved && d.kind === 'circle') {
      const r = +Math.hypot(d.b[0] - d.a[0], d.b[1] - d.a[1]).toFixed(4);
      if (r > 0) addShape(newShape('circle', { cx: d.a[0], cy: d.a[1], r }));
    }
    invalidate();
  }
}
cv.addEventListener('pointerup', endPointer);
cv.addEventListener('pointercancel', endPointer);
cv.addEventListener('pointerleave', () => { $('coords').textContent = ''; });
cv.addEventListener('contextmenu', e => e.preventDefault());
cv.addEventListener('wheel', e => {
  e.preventDefault();
  const [sx, sy] = evPos(e), wx = toWx(sx), wy = toWy(sy);
  view.s = clamp(view.s * Math.exp(-e.deltaY * 0.0015), 0.02, 400);
  view.cx = wx - (sx - W() / 2) / view.s; view.cy = wy + (sy - H() / 2) / view.s;
  invalidate();
}, { passive: false });
cv.addEventListener('dblclick', e => {
  const [sx, sy] = evPos(e);
  if (tool === 'poly' && draft) { finishPoly(); return; }
  if (tool !== 'select') return;
  const s = model.shapes[sel];
  if (!s || s.type !== 'poly') return;
  const hh = hitHandle(sx, sy);
  if (hh) { if (s.pts.length > 3) { s.pts.splice(hh.idx, 1); commit(); buildProps(); } return; }
  let best = -1, bd = 8, bp = null;
  for (let i = 0; i < s.pts.length; i++) {
    const a = s.pts[i], b = s.pts[(i + 1) % s.pts.length];
    const ax = toSx(a[0]), ay = toSy(a[1]), bx = toSx(b[0]), by = toSy(b[1]);
    const vx = bx - ax, vy = by - ay, l2 = vx * vx + vy * vy;
    const t = clamp(l2 ? ((sx - ax) * vx + (sy - ay) * vy) / l2 : 0, 0, 1);
    const d = Math.hypot(ax + t * vx - sx, ay + t * vy - sy);
    if (d < bd) { bd = d; best = i; bp = snapPt(ax + t * vx, ay + t * vy); }
  }
  if (best >= 0) { s.pts.splice(best + 1, 0, bp); commit(); buildProps(); }
});
function finishPoly() {
  const d = draft; draft = null;
  if (d && d.pts.length >= 3) addShape(newShape('poly', { pts: d.pts.map(p => p.slice()) }));
  invalidate();
}
function addShape(s) {
  model.shapes.push(s); sel = model.shapes.length - 1;
  setTool('select'); commit(); renderList(); buildProps(); renderResults();
}
function deleteSel() {
  if (sel < 0) return;
  model.shapes.splice(sel, 1); sel = -1; commit(); renderList(); buildProps(); renderResults();
}
function duplicateSel() {
  const s = model.shapes[sel]; if (!s) return;
  const t = cloneShape(s); t.name = s.name + ' (copie)';
  moveShape(t, s, 5, -5);
  model.shapes.push(t); sel = model.shapes.length - 1; commit(); renderList(); buildProps(); renderResults();
}

document.addEventListener('keydown', e => {
  const tg = e.target && e.target.tagName;
  if (tg === 'INPUT' || tg === 'TEXTAREA' || tg === 'SELECT') return;
  if (e.key === ' ') { spaceDown = true; }
  const k = e.key.toLowerCase();
  if ((e.ctrlKey || e.metaKey) && k === 'z') { e.preventDefault(); if (e.shiftKey) { if (histPos < hist.length - 1) applyHistory(histPos + 1); } else if (histPos > 0) applyHistory(histPos - 1); return; }
  if ((e.ctrlKey || e.metaKey) && k === 'y') { e.preventDefault(); if (histPos < hist.length - 1) applyHistory(histPos + 1); return; }
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  if (k === 'v') setTool('select'); else if (k === 'r') setTool('rect'); else if (k === 'c') setTool('circle');
  else if (k === 'p') setTool('poly'); else if (k === 's') setTool('probe');
  else if (k === 'delete') deleteSel();
  else if (k === 'escape') { draft = null; drag = null; invalidate(); }
  else if (k === 'enter' && draft && draft.kind === 'poly') finishPoly();
  else if (k === 'backspace' && draft && draft.kind === 'poly') { e.preventDefault(); draft.pts.pop(); if (!draft.pts.length) draft = null; invalidate(); }
});
document.addEventListener('keyup', e => { if (e.key === ' ') spaceDown = false; });

/* ------------------------------ câblage UI ------------------------------ */
document.querySelectorAll('[data-tool]').forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool)));
$('btnUndo').addEventListener('click', () => { if (histPos > 0) applyHistory(histPos - 1); });
$('btnRedo').addEventListener('click', () => { if (histPos < hist.length - 1) applyHistory(histPos + 1); });
$('btnDel').addEventListener('click', deleteSel);
$('btnDup').addEventListener('click', duplicateSel);
$('btnFit').addEventListener('click', fitView);
$('btnRun').addEventListener('click', () => runSolve(false));
$('btnMesh').addEventListener('click', () => runSolve(true));
$('inPrec').addEventListener('input', e => { model.prec = +e.target.value; $('precTxt').textContent = PREC_NAMES[model.prec]; });
$('inPrec').addEventListener('change', commit);
$('inDepth').addEventListener('change', e => { const v = parseFloat(e.target.value); if (v > 0) model.depth = v; e.target.value = model.depth; commit(); });
$('inMargin').addEventListener('change', e => { const v = parseFloat(e.target.value); if (isFinite(v) && v >= 0) model.margin = clamp(v, 0, 400); e.target.value = model.margin; commit(); });
$('inGrid').addEventListener('change', e => { grid = +e.target.value; invalidate(); });
$('inSnap').addEventListener('change', e => { snapOn = e.target.checked; });
$('optField').addEventListener('change', e => { opts.field = e.target.checked; invalidate(); });
$('optFlux').addEventListener('change', e => { opts.flux = e.target.checked; invalidate(); });
$('optVec').addEventListener('change', e => { opts.vec = e.target.checked; invalidate(); });
$('optMesh').addEventListener('change', e => { opts.mesh = e.target.checked; invalidate(); });
$('inBmax').addEventListener('change', e => { const v = parseFloat(e.target.value); opts.bmax = v > 0 ? v : 0; if (R && R.sol) buildField(); invalidate(); });
$('inNflux').addEventListener('input', e => { opts.nflux = +e.target.value; $('nfluxTxt').textContent = opts.nflux; buildIso(); invalidate(); });
$('results').addEventListener('click', e => {
  if (e.target.closest('[data-act="ind"]')) { computeInductances(); return; }
  const b = e.target.closest('[data-act="force"]');
  if (!b || !R || !R.sol || sel < 0) return;
  const f = F.maxwellForce(R.model, R.mesh, R.sol, R.loc, sel, null);
  R.force[sel] = f; renderResults();
});
$('btnCopy').addEventListener('click', () => {
  const t = $('projText'); t.value = serialize();
  const fallback = () => { t.focus(); t.select(); setStatus('Texte sélectionné : copiez-le avec Ctrl+C.'); };
  try { navigator.clipboard.writeText(t.value).then(() => setStatus('Projet copié.'), fallback); } catch (err) { fallback(); }
});
$('btnLoad').addEventListener('click', () => {
  let m = null;
  try { m = sanitizeModel(JSON.parse($('projText').value)); } catch (err) { m = null; }
  if (!m) { showBanner('Texte de projet illisible. Vérifiez le format JSON.', 'err'); return; }
  loadModel(m, 'Projet chargé.');
});
(function fillExamples() {
  const s = $('exSel');
  s.innerHTML = '<option value="">Exemples…</option>' + Object.keys(EXS).map(k => '<option value="' + k + '">' + esc(EXS[k].label) + '</option>').join('') + '<option value="__new">Projet vide</option>';
  s.addEventListener('change', () => {
    const k = s.value; s.value = '';
    if (!k) return;
    if (k === '__new') { loadModel({ depth: 50, margin: 60, prec: 3, shapes: [] }, 'Projet vide.'); return; }
    loadModel(sanitizeModel(JSON.parse(JSON.stringify(EXS[k].model))), EXS[k].label);
    if (hasSource()) runSolve(false);
  });
})();

/* ------------------------------ démarrage ------------------------------ */
function resize() {
  dpr = Math.min(2, window.devicePixelRatio || 1);
  const w = stage.clientWidth, h = stage.clientHeight;
  cv.width = Math.max(1, Math.round(w * dpr)); cv.height = Math.max(1, Math.round(h * dpr));
  cv.style.width = w + 'px'; cv.style.height = h + 'px';
  invalidate();
}
let first = true;
new ResizeObserver(() => { resize(); if (first && stage.clientWidth > 50) { first = false; fitView(); } }).observe(stage);
try { new MutationObserver(invalidate).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] }); } catch (e) { /* ignoré */ }
try { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { invalidate(); renderResults(); }); } catch (e) { /* ignoré */ }

(function init() {
  let m = null;
  try { const t = localStorage.getItem('fem2d-projet'); if (t) m = sanitizeModel(JSON.parse(t)); } catch (e) { m = null; }
  if (!m || !m.shapes.length) m = sanitizeModel(JSON.parse(JSON.stringify(EXS.electroaimant.model)));
  model = m; syncInputs(); renderList(); buildProps(); renderResults();
  hist = [JSON.stringify(model)]; histPos = 0; persist(); updateUndoButtons();
  setTool('select');
  resize();
  setTimeout(() => { if (hasSource()) runSolve(false); }, 60);
})();
})();
</script>

</body></html>
